{
  "name": "dsh-deepseek-balance",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "在 DSH 输入框下方显示 DeepSeek 官方 API 的账户余额与可用状态。 · Shows DeepSeek official API balance and availability under the composer.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jizhi0v0/dsh-plugins.git",
    "directory": "packages/deepseek-balance"
  },
  "homepage": "https://github.com/jizhi0v0/dsh-plugins/tree/main/packages/deepseek-balance"
}
